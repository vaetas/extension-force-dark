{
  "name": "extension-force-dark",
  "description": "Toggle a forced dark theme on any website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && bun scripts/e2e-modes.mjs",
    "test:site": "wxt build && bun scripts/e2e-check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wxt": "^0.19.25"
  }
}
